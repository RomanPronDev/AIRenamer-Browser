{
  "manifest_version": 3,
  "name": "AIRenamer · Browser",
  "version": "0.27.0",
  "description": "Browser panel connected to local MediaRenamer projects and files.",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "nativeMessaging",
    "downloads",
    "storage",
    "tabs",
    "contextMenus",
    "scripting",
    "alarms",
    "idle"
  ],
  "host_permissions": ["http://127.0.0.1/*"],
  "action": {
    "default_title": "Open AIRenamer"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "live.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "windows": "Ctrl+Shift+Y"
      }
    }
  }
}
